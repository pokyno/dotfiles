# env.nu
#
# version = "0.112.2"
#
# Loaded before config.nu and any autoload module is parsed. Use it to set
# PATH and to create files that later modules will `source`, since nushell's
# `source` is a parse-time keyword and parses the whole module before running
# it.

{{ if eq .chezmoi.os "linux" -}}
# --- PATH ---
# The terminal launches `nu` directly (see ~/.config/alacritty/alacritty.toml),
# so no bash/profile ever runs and ~/.cargo/env never puts ~/.cargo/bin on
# PATH. zoxide, yazi and zellij all live there. This belongs in env.nu rather
# than config.nu because env.nu runs first and the zoxide bootstrap below needs
# `which zoxide` to resolve.
#
# Entries are expanded eagerly: nushell does not expand a leading `~` when it
# looks up externals, so a literal '~/.local/bin' is a dead PATH entry.
$env.PATH = (
    [
        ($nu.home-dir | path join '.cargo' 'bin')
        ($nu.home-dir | path join '.local' 'bin')
    ]
    | append $env.PATH
    | uniq
)
{{- end }}

# --- zoxide ---
# autoload/cd-zoxide.nu does `source ~/.zoxide.nu`. `source` is a parse-time
# keyword, so that file must already exist and define __zoxide_z before the
# module is parsed, or the module fails to load and `cd` stays unaliased.
#
# Regenerate whenever the file is not genuine zoxide output (missing, empty, or
# the fallback below), so a shell that once started without zoxide on PATH does
# not leave a broken stub behind forever.
let zoxide_nu = ('~/.zoxide.nu' | path expand)
let zoxide_generated = (
    ($zoxide_nu | path exists)
        and ((open --raw $zoxide_nu) | str starts-with '# Code generated by zoxide.')
)

if (which zoxide | is-not-empty) {
    if not $zoxide_generated {
        zoxide init nushell | save -f $zoxide_nu
    }
} else if not ($zoxide_nu | path exists) {
    # No zoxide installed. Write a stub defining the names cd-zoxide.nu expects
    # so the module still parses and `cd` keeps working as plain `cd`.
    '# Fallback stub written by env.nu because zoxide was not on PATH.
# `cd` takes no ...rest, so forward the first argument only.
def --env --wrapped __zoxide_z [...rest: string] {
    if ($rest | is-empty) { cd ~ } else { cd ($rest | first) }
}
def --env --wrapped __zoxide_zi [...rest: string] {
    if ($rest | is-empty) { cd ~ } else { cd ($rest | first) }
}
' | save -f $zoxide_nu
}

# --- carapace ---
# autoload/completions.nu does `source ~/.cache/carapace/init.nu`. As with
# zoxide above, `source` is parse-time, so that file must exist before the
# module is parsed. The init script is specific to the carapace version and
# takes ~4ms to generate, so it is simply regenerated on every start. Without
# carapace on PATH an empty stub keeps the module parsing; the completer
# wrapper in completions.nu then only has argcomplete and file paths.
$env.CARAPACE_BRIDGES = 'zsh,fish,bash,inshellisense'
let carapace_init = ('~/.cache/carapace/init.nu' | path expand)
mkdir ($carapace_init | path dirname)
if (which carapace | is-not-empty) {
    carapace _carapace nushell | save -f $carapace_init
} else {
    '# Stub written by env.nu because carapace was not on PATH.
' | save -f $carapace_init
}
