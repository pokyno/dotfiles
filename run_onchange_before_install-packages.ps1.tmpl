{{- if ne .chezmoi.os "windows" -}}
# Windows-only installer; no-op on this OS.
exit 0
{{- end }}

# Idempotent install of dotfile-tools on Windows (winget + cargo, version-pinned).
# Re-runs only when this file's content changes (chezmoi run_onchange_).

$ErrorActionPreference = 'Stop'

# --- Pinned versions for cargo-built tools. Bump explicitly to upgrade. ---
$NU_VERSION     = '0.112.2'
$ZELLIJ_VERSION = '0.44.2'
$OUCH_VERSION   = '0.7.1'
$ZOXIDE_VERSION = '0.9.9'

function Test-Cmd { param([string]$Name) $null -ne (Get-Command $Name -ErrorAction SilentlyContinue) }

function Install-Winget {
    param([string]$Id, [string]$VerifyCmd)
    if (Test-Cmd $VerifyCmd) { return }
    Write-Host "Installing $Id via winget..."
    & winget install --id $Id -e --silent --accept-package-agreements --accept-source-agreements 2>&1 |
        Where-Object { $_ -notmatch '^\s*$' } | ForEach-Object { Write-Host "  $_" }
}

if (-not (Test-Cmd 'winget')) {
    Write-Warning "winget is not available. Install 'App Installer' from the Microsoft Store first."
    exit 1
}

# --- bootstrapping deps ---
Install-Winget 'Git.Git'         'git'
Install-Winget 'Rustlang.Rustup' 'rustup'
# LLVM provides libclang.dll, needed by bindgen (pulled in via ouch -> libbzip3-sys)
Install-Winget 'LLVM.LLVM'       'clang'

# Refresh PATH so this session sees just-installed package bin dirs (cargo, etc.)
$env:Path = [Environment]::GetEnvironmentVariable('Path','Machine') + ';' +
            [Environment]::GetEnvironmentVariable('Path','User')

if (Test-Cmd 'rustup') {
    & rustup default stable | Out-Null
    & rustup update stable --no-self-update | Out-Null
}

# bindgen needs libclang.dll on PATH or via LIBCLANG_PATH; point it at the
# winget install if the env var isn't already set.
if (-not $env:LIBCLANG_PATH) {
    $llvmBin = Join-Path $env:ProgramFiles 'LLVM\bin'
    if (Test-Path (Join-Path $llvmBin 'libclang.dll')) {
        $env:LIBCLANG_PATH = $llvmBin
    }
}

# --- winget user tools (no cargo build we want to take here) ---
$pkgs = @(
    @{ id = 'junegunn.fzf';        cmd = 'fzf' }
    @{ id = 'sxyazi.yazi';         cmd = 'yazi' }
    @{ id = 'Neovim.Neovim';       cmd = 'nvim' }
    @{ id = 'Alacritty.Alacritty'; cmd = 'alacritty' }
)
foreach ($p in $pkgs) { Install-Winget $p.id $p.cmd }

# --- cargo-built, version-pinned (cargo no-ops if already at version) ---
Write-Host "Installing/updating cargo-built tools (pinned)..."
& cargo install --locked --version $NU_VERSION     nu
& cargo install --locked --version $ZELLIJ_VERSION zellij
& cargo install --locked --version $OUCH_VERSION   ouch
& cargo install --locked --version $ZOXIDE_VERSION zoxide

# Pre-render zoxide's nushell init. nushell's `source` is parse-time, so
# autoload/cd-zoxide.nu fails to parse on a fresh shell unless this file
# already exists.
if (Test-Cmd 'zoxide') {
    [System.IO.File]::WriteAllText(
        (Join-Path $HOME '.zoxide.nu'),
        ((& zoxide init nushell) -join "`n")
    )
}

# --- FiraMono Nerd Font (per-user, no admin needed) ---
$fontDir = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows\Fonts'
$installed = Get-ChildItem $fontDir -Filter 'FiraMono*Nerd*' -ErrorAction SilentlyContinue
if (-not $installed) {
    Write-Host "Installing FiraMono Nerd Font..."
    New-Item -ItemType Directory -Path $fontDir -Force | Out-Null
    $tmpDir = Join-Path $env:TEMP "FiraMonoNF-$(Get-Random)"
    New-Item -ItemType Directory -Path $tmpDir -Force | Out-Null
    $zip = Join-Path $tmpDir 'FiraMono.zip'
    Invoke-WebRequest -UseBasicParsing `
        -Uri 'https://github.com/ryanoasis/nerd-fonts/releases/latest/download/FiraMono.zip' `
        -OutFile $zip
    Expand-Archive $zip -DestinationPath $tmpDir -Force
    $regKey = 'HKCU:\Software\Microsoft\Windows NT\CurrentVersion\Fonts'
    Get-ChildItem $tmpDir -Filter '*.ttf' | ForEach-Object {
        Copy-Item $_.FullName $fontDir -Force
        New-ItemProperty -Path $regKey -Name $_.BaseName -Value $_.Name -PropertyType String -Force | Out-Null
    }
    Remove-Item $tmpDir -Recurse -Force
}

# --- yazi plugins ---
if ((Test-Cmd 'ya') -and (Test-Path "$env:APPDATA\yazi\config\package.toml")) {
    & ya pkg upgrade *> $null
}

Write-Host "All tools present."
