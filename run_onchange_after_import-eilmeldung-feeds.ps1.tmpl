{{- if eq .chezmoi.os "windows" -}}
# Re-runs whenever feeds.opml changes (chezmoi run_onchange_ keys on script hash).
# OPML content hash: {{ include "dot_config/eilmeldung/feeds.opml" | sha256sum }}

$ErrorActionPreference = 'Stop'

$opml = Join-Path $env:USERPROFILE '.config\eilmeldung\feeds.opml'

if (-not (Get-Command eilmeldung -ErrorAction SilentlyContinue) -or -not (Test-Path $opml)) {
    exit 0
}

# feed_id (URL) is the primary key in news_flash's local_rss schema, so
# re-importing existing feeds is a no-op.
& eilmeldung --import-opml $opml --quiet
{{- end -}}
