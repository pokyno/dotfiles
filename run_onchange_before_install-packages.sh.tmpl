#!/usr/bin/env bash
{{- if ne .chezmoi.os "linux" }}
# Linux-only installer; no-op on this OS.
exit 0
{{- end }}

# Idempotent install of dotfile-tools on Linux (apt + cargo, version-pinned).
# Re-runs only when this file's content changes (chezmoi run_onchange_).

set -euo pipefail

# --- Pinned versions for cargo-built tools. Bump explicitly to upgrade. ---
readonly NU_VERSION="0.112.2"
readonly ZELLIJ_VERSION="0.44.2"
readonly YAZI_VERSION="26.5.6"
readonly OUCH_VERSION="0.7.1"
readonly ZOXIDE_VERSION="0.9.9"
readonly EILMELDUNG_VERSION="1.5.0"

LOCAL_BIN="$HOME/.local/bin"
CARGO_BIN="$HOME/.cargo/bin"
mkdir -p "$LOCAL_BIN"
case ":$PATH:" in *":$LOCAL_BIN:"*) ;; *) export PATH="$LOCAL_BIN:$PATH" ;; esac
case ":$PATH:" in *":$CARGO_BIN:"*) ;; *) export PATH="$CARGO_BIN:$PATH" ;; esac

need() { ! command -v "$1" >/dev/null 2>&1; }

apt_install() {
    [ $# -gt 0 ] || return 0
    if command -v apt-get >/dev/null; then
        sudo apt-get update -qq
        sudo apt-get install -y "$@"
    else
        echo "apt-get not found; skipping: $*" >&2
    fi
}

# --- core deps (apt) ---
APT_CORE=()
need curl     && APT_CORE+=(curl)
need git      && APT_CORE+=(git)
need fc-cache && APT_CORE+=(fontconfig)
need xclip    && APT_CORE+=(xclip)
need unzip    && APT_CORE+=(unzip)
apt_install "${APT_CORE[@]}"

# --- build toolchain for cargo crates (idempotent on apt) ---
# libclang-dev: bindgen (pulled in via ouch -> libbzip3-sys) needs libclang.so
apt_install build-essential pkg-config libssl-dev libclang-dev

# --- apt-installable user tools (no cargo build we want to take here) ---
APT_TOOLS=()
need fzf       && APT_TOOLS+=(fzf)
{{- if not (contains "microsoft" (lower .chezmoi.kernel.osrelease)) }}
need alacritty && APT_TOOLS+=(alacritty)
{{- end }}
need nvim      && APT_TOOLS+=(neovim)
apt_install "${APT_TOOLS[@]}"

# --- rust toolchain (rustup) ---
if need rustup; then
    echo "Installing rustup..."
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --default-toolchain stable --profile minimal --no-modify-path
fi
# shellcheck source=/dev/null
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
# yazi 26.x requires rustc >= 1.95; ensure stable is current.
rustup update stable --no-self-update >/dev/null

# --- cargo-built, version-pinned (cargo no-ops if already at version) ---
echo "Installing/updating cargo-built tools (pinned)..."
cargo install --locked --version "$NU_VERSION"     nu
cargo install --locked --version "$ZELLIJ_VERSION" zellij
cargo install --locked --version "$OUCH_VERSION"   ouch
cargo install --locked --version "$ZOXIDE_VERSION" zoxide

# eilmeldung: prebuilt static-musl binary (cargo build needs libxml2/sqlite3 dev headers).
case "$(uname -m)" in
    x86_64|amd64)  EILMELDUNG_TARGET="x86_64-unknown-linux-musl" ;;
    aarch64|arm64) EILMELDUNG_TARGET="aarch64-unknown-linux-musl" ;;
    armv7l)        EILMELDUNG_TARGET="armv7-unknown-linux-musleabihf" ;;
    *)             EILMELDUNG_TARGET="" ;;
esac
if [ -n "$EILMELDUNG_TARGET" ]; then
    installed_ver=""
    if [ -x "$LOCAL_BIN/eilmeldung" ]; then
        installed_ver="$("$LOCAL_BIN/eilmeldung" --version 2>/dev/null | awk '{print $2}')"
    fi
    if [ "$installed_ver" != "$EILMELDUNG_VERSION" ]; then
        echo "Installing eilmeldung $EILMELDUNG_VERSION binary..."
        tmp="$(mktemp -d)"
        url="https://github.com/christo-auer/eilmeldung/releases/download/$EILMELDUNG_VERSION/eilmeldung-$EILMELDUNG_TARGET-$EILMELDUNG_VERSION.tar.gz"
        curl -fsSL -o "$tmp/eilmeldung.tar.gz" "$url"
        tar -xzf "$tmp/eilmeldung.tar.gz" -C "$tmp"
        bin="$(find "$tmp" -type f -name eilmeldung -perm -u+x | head -n1)"
        if [ -z "$bin" ]; then
            echo "eilmeldung binary not found in release tarball" >&2
            rm -rf "$tmp"; exit 1
        fi
        install -m 0755 "$bin" "$LOCAL_BIN/eilmeldung"
        rm -rf "$tmp"
        # Remove any stale cargo-installed eilmeldung that would shadow $LOCAL_BIN on PATH.
        [ -f "$CARGO_BIN/eilmeldung" ] && rm -f "$CARGO_BIN/eilmeldung"
    fi
fi

# Pre-render zoxide's nushell init. nushell's `source` is parse-time, so
# autoload/cd-zoxide.nu fails to parse on a fresh shell unless this file
# already exists.
if command -v zoxide >/dev/null; then
    zoxide init nushell > "$HOME/.zoxide.nu"
fi

# yazi: install via the yazi-build meta-crate from the tagged git source.
# yazi-fm/yazi-cli refuse to build directly (their build.rs panics with a
# "must be built with cargo install --force yazi-build" message), so we
# install yazi-build, which orchestrates the real build of yazi-fm + yazi-cli.
# --locked still pins transitive deps via the tag's Cargo.lock.
if ! yazi --version 2>/dev/null | grep -qF "$YAZI_VERSION"; then
    cargo install --force --locked \
        --git https://github.com/sxyazi/yazi.git \
        --tag "v$YAZI_VERSION" \
        yazi-build
fi

# --- FiraMono Nerd Font ---
FONT_DIR="$HOME/.local/share/fonts/NerdFonts"
if ! fc-list 2>/dev/null | grep -qi "FiraMono Nerd Font"; then
    echo "Installing FiraMono Nerd Font..."
    mkdir -p "$FONT_DIR"
    tmp="$(mktemp -d)"
    curl -fsSL -o "$tmp/FiraMono.zip" \
        "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/FiraMono.zip"
    unzip -oq "$tmp/FiraMono.zip" -d "$FONT_DIR"
    fc-cache -f "$FONT_DIR"
    rm -rf "$tmp"
fi

# --- yazi plugins (after yazi+ya are present and configs deployed) ---
if command -v ya >/dev/null && [ -f "$HOME/.config/yazi/package.toml" ]; then
    ya pkg upgrade >/dev/null 2>&1 || true
fi

echo "All tools present."
