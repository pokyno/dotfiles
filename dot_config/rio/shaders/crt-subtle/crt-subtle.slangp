# Subtle variant of Rio's built-in newpixie CRT filter.
# Tweak the values at the bottom (0 = off, 1 = original built-in strength).
shaders = 4

shader0 = accumulate.slang
alias0 = accum1
scale0 = 1.0
scale_type0 = source
filter_linear0 = true

shader1 = blur_horiz.slang
alias1 = blur1
scale1 = 1.0
scale_type1 = source
filter_linear1 = true

shader2 = blur_vert.slang
alias2 = blur2
scale2 = 1.0
scale_type2 = source
filter_linear2 = true

shader3 = newpixie-crt.slang
filter_linear3 = true
scale_type3 = viewport

textures = "frametexture"
frametexture = crtframe.png
frametexture_linear = true
frametexture_wrap_mode = clamp_to_border

parameters = "curvature;scanroll;vignette;ghosting;blur_x;blur_y;acc_modulate;scan_strength;mask_strength"
curvature = 1.0        # screen bulge        (built-in 2.0, range 0.0001–4)
scanroll = 1.0         # rolling scanlines   (1 = moving, 0 = static; needs strategy "game")
vignette = 0.4         # dark corners        (built-in 1.0)
ghosting = 0.3         # colour bleed/glow   (built-in 1.0, range 0–2)
blur_x = 0.5           # glow blur           (built-in 1.0)
blur_y = 0.5
acc_modulate = 0.4     # phosphor smear      (built-in 0.65)
scan_strength = 0.85   # scanline darkness   (built-in 1.0; 0 = none)
mask_strength = 0.4    # vertical RGB mask   (built-in 1.0)
